# Supabase Postgres connection. Use the pooled URL in deployed environments.
DATABASE_URL="postgresql://postgres.PROJECT:password@HOST:6543/postgres?pgbouncer=true"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Used only by `npm run db:seed`; never commit real passcodes.
AMIR_PASSCODE=""
KIMIA_PASSCODE=""

# Private Supabase Storage bucket used by server-side uploads.
SUPABASE_URL="https://PROJECT.supabase.co"
# Use a modern Supabase secret key, or the legacy service_role key. Server only.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_MEDIA_BUCKET="memories"
